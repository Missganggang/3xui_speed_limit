[Unit]
Description=3x-ui Port Speed Limiter
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/3xui-speed
ExecStartPre=/opt/3xui-speed/venv/bin/python app.py --reload
ExecStart=/opt/3xui-speed/venv/bin/python app.py
Restart=on-failure
RestartSec=5
Environment=PORT=7788
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
